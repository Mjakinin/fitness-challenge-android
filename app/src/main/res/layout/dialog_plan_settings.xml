<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#131B2E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯 Trainings-Splits &amp; Modus"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wähle dein Wochen-Preset und wie du erinnert werden willst."
            android:textSize="12sp"
            android:textColor="@color/text_gray"
            android:layout_marginBottom="16dp" />

        <!-- 1. Mode Selector -->
        <RadioGroup
            android:id="@+id/rgPlanMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">

            <RadioButton
                android:id="@+id/rbSporadic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔄 Sporadisch / Flexibel (Keine festen Tage)\nErinnerungen nur bei Bedarf (früh, mittags, abends je nach Puffer)"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:buttonTint="@color/orange_primary"
                android:paddingStart="8dp"
                android:layout_marginBottom="8dp" />

            <RadioButton
                android:id="@+id/rbFixedDays"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📅 Feste Tage planen\nReminder gezielt an deinen gewählten Wochentagen"
                android:textColor="@color/text_white"
                android:textSize="12sp"
                android:buttonTint="@color/orange_primary"
                android:paddingStart="8dp" />
        </RadioGroup>

        <!-- Fixed Days Selection -->
        <LinearLayout
            android:id="@+id/layoutFixedDays"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRAININGSTAGE AUSWÄHLEN:"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/text_muted"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ToggleButton
                    android:id="@+id/tbMon"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:textOn="Mo"
                    android:textOff="Mo"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ToggleButton
                    android:id="@+id/tbTue"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:textOn="Di"
                    android:textOff="Di"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ToggleButton
                    android:id="@+id/tbWed"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:textOn="Mi"
                    android:textOff="Mi"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ToggleButton
                    android:id="@+id/tbThu"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:textOn="Do"
                    android:textOff="Do"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ToggleButton
                    android:id="@+id/tbFri"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:textOn="Fr"
                    android:textOff="Fr"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ToggleButton
                    android:id="@+id/tbSat"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:textOn="Sa"
                    android:textOff="Sa"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <ToggleButton
                    android:id="@+id/tbSun"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:textOn="So"
                    android:textOff="So"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 2. Preset Splits List -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRAININGS-SPLIT WÄHLEN (GENAU 4 EINHEITEN):"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelPlan"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Abbrechen"
                android:textColor="@color/text_gray" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSavePlan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Speichern"
                android:textStyle="bold"
                app:backgroundTint="@color/orange_primary"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
